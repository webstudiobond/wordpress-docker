# IP Access Control (Allow / Deny Rules)
# Included inside the server block
#
# Because Real IP is trusted from Edge Angie (set_real_ip_from 172.20.0.0/16),
# $remote_addr contains the client's actual public IP.

# Scenario A: Whitelist mode (e.g. staging, private testing, maintenance)
# Allow trusted IPs and deny everyone else:
# allow 192.0.2.1;
# allow 198.51.100.0/24;
# deny all;

# Scenario B: Blacklist mode (block specific malicious IPs or subnets)
# deny 203.0.113.5;
# deny 198.51.100.0/24;
