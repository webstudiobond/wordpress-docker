    public function filterCustomMenuOrder(mixed $custom): bool
    {
        $rawOrder = $this->getEnv('WP_ADMIN_MENU_ORDER');
        if ($rawOrder !== false && trim($rawOrder) !== '') {
            return true;
        }

        $rawSeps = $this->getEnv('WP_ADMIN_SIDEBAR_MENU_SEPARATORS_AFTER');
        if ($rawSeps !== false && trim($rawSeps) !== '') {
            return true;
        }

        return (bool) $custom;
    }

    /**
     * @param array<int|string, mixed> $menuOrder
     * @return array<int|string, mixed>
     */
    public function filterMenuOrder(array $menuOrder): array
    {
        $rawOrder = $this->getEnv('WP_ADMIN_MENU_ORDER');
        if ($rawOrder === false || trim($rawOrder) === '') {
            if ($this->separatorAfterMap !== []) {
                $reordered = $menuOrder;
                foreach ($this->separatorAfterMap as $targetSlug => $sepSlug) {
                    $targetPos = array_search($targetSlug, $reordered, true);
                    $sepPos = array_search($sepSlug, $reordered, true);
                    if ($targetPos !== false) {
                        if ($sepPos !== false) {
                            array_splice($reordered, (int) $sepPos, 1);
                            $targetPos = array_search($targetSlug, $reordered, true);
                        }
                        array_splice($reordered, (int) $targetPos + 1, 0, [$sepSlug]);
                    }
                }
                return $reordered;
            }
            return $menuOrder;
        }

        $customItems = [];
        foreach (explode(',', trim($rawOrder)) as $item) {
            $trimmed = trim($item);
            if ($trimmed !== '') {
                $customItems[] = $trimmed;
            }
        }

        if ($customItems === []) {
            return $menuOrder;
        }

        $reordered = [];
        foreach ($customItems as $custom) {
            if (in_array($custom, $menuOrder, true)) {
                $reordered[] = $custom;
            }
        }

        foreach ($menuOrder as $existing) {
            if (!in_array($existing, $reordered, true)) {
                $reordered[] = $existing;
            }
        }

        if ($this->separatorAfterMap !== []) {
            foreach ($this->separatorAfterMap as $targetSlug => $sepSlug) {
                $targetPos = array_search($targetSlug, $reordered, true);
                $sepPos = array_search($sepSlug, $reordered, true);
                if ($targetPos !== false) {
                    if ($sepPos !== false) {
                        array_splice($reordered, (int) $sepPos, 1);
                        $targetPos = array_search($targetSlug, $reordered, true);
                    }
                    array_splice($reordered, (int) $targetPos + 1, 0, [$sepSlug]);
                }
            }
        }

        return $reordered;
    }

    public function filterParentFile(string $parentFile): string
    {
        $currentUser = $this->getCurrentUser();
        $customMenus = $this->getCustomMenus();
        if ($customMenus === []) {
            return $parentFile;
        }

        $pagenow = isset($GLOBALS['pagenow']) && is_string($GLOBALS['pagenow']) ? $GLOBALS['pagenow'] : '';
        $pluginPage = isset($GLOBALS['plugin_page']) && is_string($GLOBALS['plugin_page'])
            ? $GLOBALS['plugin_page']
            : null;

        foreach ($customMenus as $menu) {
            if (!$this->isUserAllowedCustomMenu($menu, $currentUser)) {
                continue;
            }

            $rawItems = is_array($menu['items'] ?? null) ? $menu['items'] : [];
            foreach ($rawItems as $item) {
                if (!is_array($item)) {
                    continue;
                }
                $itemUrl = is_string($item['url'] ?? null) ? $item['url'] : '';
                if ($this->isCurrentUrlMatching($itemUrl, $pagenow, $pluginPage)) {
                    $menuId = is_string($menu['id'] ?? null) ? $menu['id'] : '';
                    if ($pluginPage !== null && $pluginPage !== '') {
                        $this->registerParentPage($pluginPage, $menuId);
                    }
                    $this->registerParentPage($itemUrl, $menuId);
                    $GLOBALS['parent_file'] = $menuId;
                    return $menuId;
                }
            }
        }

        return $parentFile;
    }

    public function filterSubmenuFile(?string $submenuFile, string $parentFile = ''): ?string
    {
        $currentUser = $this->getCurrentUser();
        $customMenus = $this->getCustomMenus();
        if ($customMenus === []) {
            return $submenuFile;
        }

        $pagenow = isset($GLOBALS['pagenow']) && is_string($GLOBALS['pagenow']) ? $GLOBALS['pagenow'] : '';
        $pluginPage = isset($GLOBALS['plugin_page']) && is_string($GLOBALS['plugin_page'])
            ? $GLOBALS['plugin_page']
            : null;

        foreach ($customMenus as $menu) {
            if (!$this->isUserAllowedCustomMenu($menu, $currentUser)) {
                continue;
            }

            $menuId = is_string($menu['id'] ?? null) ? $menu['id'] : '';
            $rawItems = is_array($menu['items'] ?? null) ? $menu['items'] : [];
            foreach ($rawItems as $item) {
                if (!is_array($item)) {
                    continue;
                }
                $itemUrl = is_string($item['url'] ?? null) ? $item['url'] : '';
                if ($this->isCurrentUrlMatching($itemUrl, $pagenow, $pluginPage)) {
                    $GLOBALS['submenu_file'] = $itemUrl;
                    return $itemUrl;
                }
            }
        }

        return $submenuFile;
    }

    public function isCurrentUrlMatching(string $itemUrl, string $pagenow, ?string $pluginPage): bool
    {
        $trimmed = trim($itemUrl);
        if ($trimmed === '') {
            return false;
        }

        if ($pluginPage !== null && $pluginPage !== '') {
            if ($trimmed === $pluginPage || $trimmed === 'admin.php?page=' . $pluginPage) {
                return true;
            }
        }

        $parsed = parse_url($trimmed);
        if (!is_array($parsed)) {
            return false;
        }

        $rawPath = isset($parsed['path']) ? $parsed['path'] : '';
        $pathBasename = basename($rawPath);
        $query = isset($parsed['query']) ? $parsed['query'] : '';

        if ($pathBasename !== '' && $pagenow !== '' && $pathBasename === $pagenow && $query === '') {
            return $pluginPage === null || $pluginPage === '';
        }

        if ($query !== '') {
            $parsedParams = [];
            parse_str($query, $parsedParams);
            if ($parsedParams !== []) {
                if ($pathBasename !== '' && $pagenow !== '' && $pathBasename !== $pagenow) {
                    return false;
                }

                $currentParams = $_GET;
                if ($pluginPage !== null && $pluginPage !== '' && !isset($currentParams['page'])) {
                    $currentParams['page'] = $pluginPage;
                }

                foreach ($parsedParams as $k => $v) {
                    $strKey = (string) $k;
                    $strVal = is_scalar($v) ? (string) $v : '';
                    if (!isset($currentParams[$strKey]) || !is_scalar($currentParams[$strKey])) {
                        return false;
                    }
                    if ((string) $currentParams[$strKey] !== $strVal) {
                        return false;
                    }
                }

                return true;
            }
        }

        return false;
    }

    /**
     * @return list<array<string, mixed>>
     */
    public function getCustomMenus(): array
    {
        if ($this->cachedCustomMenus !== null) {
            return $this->cachedCustomMenus;
        }

        $menus = [];

        for ($index = 1; ; $index++) {
            $titleRaw = $this->getEnv('WP_ADMIN_CUSTOM_MENU_' . $index . '_TITLE');
            if ($titleRaw === false || trim($titleRaw) === '') {
                break;
            }

            $title = strip_tags(trim($titleRaw));

            $idRaw = $this->getEnv('WP_ADMIN_CUSTOM_MENU_' . $index . '_ID');
            $id = ($idRaw !== false && trim($idRaw) !== '')
                ? trim($idRaw)
                : 'custom-menu-' . $index;

            $iconRaw = $this->getEnv('WP_ADMIN_CUSTOM_MENU_' . $index . '_ICON');
            $icon = ($iconRaw !== false && trim($iconRaw) !== '') ? trim($iconRaw) : 'dashicons-admin-generic';

            $targetRaw = $this->getEnv('WP_ADMIN_CUSTOM_MENU_' . $index . '_TARGET');
            $targetRuleStr = ($targetRaw !== false && trim($targetRaw) !== '')
                ? 'custom_menu|' . trim($targetRaw)
                : 'custom_menu|all';
            $parsedTargetRules = $this->parseRules($targetRuleStr);

            $itemsRaw = $this->getEnv('WP_ADMIN_CUSTOM_MENU_' . $index . '_ITEMS');
            $rawList = ($itemsRaw !== false && trim($itemsRaw) !== '') ? explode(';', trim($itemsRaw)) : [];

            $items = [];
            foreach ($rawList as $rawItem) {
                $trimmedItem = trim($rawItem);
                if ($trimmedItem === '') {
                    continue;
                }
                $parts = explode('|', $trimmedItem);
                $subTitle = trim($parts[0]);
                $subUrl = isset($parts[1]) ? trim($parts[1]) : '';
                if ($subTitle !== '' && $subUrl !== '') {
                    $items[] = ['title' => $subTitle, 'url' => $subUrl];
                }
            }

            $menus[] = [
                'id' => $id,
                'title' => $title,
                'icon' => $icon,
                'targetRules' => $parsedTargetRules,
                'items' => $items,
            ];
        }

        $this->cachedCustomMenus = $menus;
        return $this->cachedCustomMenus;
    }

    /**
     * @param array<string, mixed> $menu
     */
    private function isUserAllowedCustomMenu(array $menu, ?object $user): bool
    {
        if ($this->isSuperAdmin($user)) {
            return true;
        }

        $rawRules = is_array($menu['targetRules'] ?? null) ? $menu['targetRules'] : [];
        if ($rawRules === []) {
            return true;
        }

        $firstRule = $rawRules[0] ?? null;
        if (!is_array($firstRule)) {
            return true;
        }

        /** @var AdminRule $firstRule */
        return $this->isUserMatchingCosmeticRule($firstRule, $user);
    }

    private function registerParentPage(string $childSlug, string $parentSlug): void
    {
        if ($childSlug === '' || $parentSlug === '') {
            return;
        }

        if (!isset($GLOBALS['_parent_pages']) || !is_array($GLOBALS['_parent_pages'])) {
            $GLOBALS['_parent_pages'] = [];
        }

        /** @var array<string, string> $parentPages */
        $parentPages = &$GLOBALS['_parent_pages'];
        $parentPages[$childSlug] = $parentSlug;
    }

    public function filterScreenOptionsShowScreen(mixed $show): bool
    {
        if ($this->isSuperAdmin($this->getCurrentUser())) {
            return true;
        }

        $raw = $this->getEnv('WP_ADMIN_DISABLE_SCREEN_OPTIONS');
        if ($raw !== false && filter_var($raw, FILTER_VALIDATE_BOOLEAN)) {
            return false;
        }

        return (bool) $show;
    }

