    public function filterRestPrepareComment(mixed $response, mixed $comment, mixed $request): mixed
    {
        if (!is_object($response)) {
            return $response;
        }

        $currentUser = $this->getCurrentUser();
        if ($this->isSuperAdmin($currentUser)) {
            return $response;
