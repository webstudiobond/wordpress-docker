    /**
     * @param (callable(string): (string|false))|null $envGetter
     * @param (callable(): string)|null $localeGetter
     * @param (callable(string): string)|null $accentRemover
     * @param (callable(string, callable, int, int): void)|null $filterAdder
     */
    public function __construct(
        private readonly mixed $envGetter = null,
        private readonly mixed $localeGetter = null,
        private readonly mixed $accentRemover = null,
        private readonly mixed $filterAdder = null
    ) {
    }

    public function isSlugsEnabled(): bool
    {
        return $this->isEnvEnabled('WP_TRANSLIT_SLUGS');
    }

    public function isFilenamesEnabled(): bool
    {
        return $this->isEnvEnabled('WP_TRANSLIT_FILENAMES');
    }

    public function getConfiguredTable(): string
    {
        $raw = $this->getEnv('WP_TRANSLIT_TABLE');
        if ($raw === false || trim($raw) === '') {
            return 'universal';
        }

        $normalized = strtolower(trim($raw));
        if ($normalized === 'auto') {
            $locale = strtolower(trim($this->getCurrentLocale()));
            return self::LOCALE_ALIASES[$locale] ?? 'universal';
        }

        return self::LOCALE_ALIASES[$normalized] ?? 'universal';
    }

    /**
     * @return array<string, string>
     */
    public function getCustomOverrides(): array
    {
        $raw = $this->getEnv('WP_TRANSLIT_OVERRIDES');
        if ($raw === false || trim($raw) === '') {
            return [];
        }

        $overrides = [];
        foreach (explode(',', $raw) as $pair) {
            $trimmedPair = trim($pair);
            if ($trimmedPair === '' || !str_contains($trimmedPair, ':')) {
                continue;
            }

            [$source, $target] = explode(':', $trimmedPair, 2);
            $sourceKey = trim($source);
            if ($sourceKey !== '') {
                $overrides[$sourceKey] = trim($target);
            }
        }

        return $overrides;
    }

    /**
     * @return array<string, string>
     */
    public function getConversionTable(): array
    {
        $tableKey = $this->getConfiguredTable();

        if ($tableKey === 'universal') {
            $table = array_replace(
                self::ISO9_TABLE,
                self::UNIVERSAL_CYRILLIC_EXTENSIONS,
                self::STANDALONE_TABLES['el'],
                self::STANDALONE_TABLES['hy'],
                self::STANDALONE_TABLES['ka_GE'],
                self::STANDALONE_TABLES['he_IL']
            );
        } elseif (isset(self::STANDALONE_TABLES[$tableKey])) {
            $table = self::STANDALONE_TABLES[$tableKey];
        } else {
            $table = self::ISO9_TABLE;
            if (isset(self::LOCALE_OVERRIDES[$tableKey])) {
                $table = array_replace($table, self::LOCALE_OVERRIDES[$tableKey]);
            }
        }

        $customOverrides = $this->getCustomOverrides();
        if ($customOverrides !== []) {
            $table = array_replace($table, $customOverrides);
        }

        return $table;
    }

    public function transliterate(string $value): string
    {
        if ($value === '') {
            return '';
        }

        $normalized = strtr($value, self::MAC_NFD_MAP);
        $prepared = $this->applyPositionalRules($normalized);

        return strtr($prepared, $this->getConversionTable());
    }

    public function sanitizeTitle(string $title, string $rawTitle = '', string $context = 'save'): string
    {
        unset($rawTitle);

        if (!$this->isSlugsEnabled() || $context !== 'save' || $title === '') {
            return $title;
        }

        return $this->transliterate($title);
    }

    public function sanitizeFileName(string $filename): string
    {
        if (!$this->isFilenamesEnabled() || $filename === '') {
            return $filename;
        }

        $unaccented = $this->removeAccents($filename);

        return $this->transliterate($unaccented);
    }

    public function registerHooks(): void
    {
        if ($this->isSlugsEnabled()) {
            $this->addFilter('sanitize_title', [$this, 'sanitizeTitle'], 9, 3);
        }

        if ($this->isFilenamesEnabled()) {
            $this->addFilter('sanitize_file_name', [$this, 'sanitizeFileName'], 10, 1);
        }
    }

    private function applyPositionalRules(string $text): string
    {
        $tableKey = $this->getConfiguredTable();
        if ($tableKey !== 'uk' && $tableKey !== 'universal') {
            return $text;
        }

        $text = (string) preg_replace('/(?<=\p{Cyrillic})[\'\x{2019}\x{02BC}](?=\p{Cyrillic})/u', '', $text);
        $customOverrides = $this->getCustomOverrides();

        if ($tableKey === 'uk') {
            return (string) preg_replace_callback(
                '/(?<=\p{Cyrillic})([ЄєЇїЙйЮюЯя])/u',
                static function (array $matches) use ($customOverrides): string {
                    $char = $matches[1];
                    if (array_key_exists($char, $customOverrides)) {
                        return $char;
                    }

                    return self::UK_WORD_INTERNAL_MAP[$char];
                },
                $text
            );
        }

        return (string) preg_replace_callback(
            '/(?<=\p{Cyrillic})(?<![Ии])([Її])/u',
            static function (array $matches) use ($customOverrides): string {
                $char = $matches[1];
                if (array_key_exists($char, $customOverrides)) {
                    return $char;
                }

                return $char === 'Ї' ? 'I' : 'i';
            },
            $text
        );
    }

    private function isEnvEnabled(string $envName): bool
    {
        $raw = $this->getEnv($envName);
        if ($raw === false || trim($raw) === '') {
            return true;
        }

        return !in_array(strtolower(trim($raw)), ['false', '0', 'off', 'no'], true);
    }

    private function getCurrentLocale(): string
    {
        if (is_callable($this->localeGetter)) {
            return (string) ($this->localeGetter)();
        }

        if (function_exists('get_locale')) {
            return get_locale();
        }

        return 'universal';
    }

    private function removeAccents(string $value): string
    {
        if (is_callable($this->accentRemover)) {
            return (string) ($this->accentRemover)($value);
        }

        if (function_exists('remove_accents')) {
            return remove_accents($value);
        }

        return $value;
    }

    private function addFilter(string $tag, callable $callback, int $priority, int $acceptedArgs): void
    {
        if (is_callable($this->filterAdder)) {
            ($this->filterAdder)($tag, $callback, $priority, $acceptedArgs);
            return;
        }

        if (function_exists('add_filter')) {
            add_filter($tag, $callback, $priority, $acceptedArgs);
        }
    }

    private function getEnv(string $name): string|false
    {
        if (is_callable($this->envGetter)) {
            return ($this->envGetter)($name);
        }

        return getenv($name);
    }
}

if (function_exists('add_filter')) {
    (new WpTransliterator())->registerHooks();
}
