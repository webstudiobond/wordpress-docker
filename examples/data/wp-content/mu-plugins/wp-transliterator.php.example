<?php

/**
 * Plugin Name: WP Transliterator
 * Description: Transliterates non-Latin post, page, and term slugs on save and uploaded media filenames.
 * Version: 1.0.0
 * Author: underhax
 */

declare(strict_types=1);

/**
 * Converts non-Latin characters in newly saved WordPress slugs and uploaded
 * media filenames into Latin equivalents using ISO 9, locale-specific, or universal tables.
 */
