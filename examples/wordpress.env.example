# Optional WordPress Application Overrides
# Copy to wordpress.env in your site directory (/home/${SITE_USER}/wordpress.env)

# Background Cron (disable virtual web cron when using real system cron)
# WORDPRESS_DISABLE_CRON=true

# Post Revisions (number of revisions to retain, or false to disable)
# WORDPRESS_POST_REVISIONS=2

# Filesystem Permissions for uploads/plugins (default: 0755 dirs, 0644 files)
# WORDPRESS_FS_CHMOD_DIR=0755
# WORDPRESS_FS_CHMOD_FILE=0644

# Site URLs (overrides database settings, useful for staging/dev)
# WORDPRESS_HOME=https://example.com
# WORDPRESS_SITEURL=https://example.com
# WORDPRESS_CLI_HOST=example.com

# Memory Limits (within container limit of 768M)
# WORDPRESS_MEMORY_LIMIT=256M
# WORDPRESS_MAX_MEMORY_LIMIT=512M

# Debugging
# WORDPRESS_DEBUG=true
# WORDPRESS_DEBUG_LOG=true
# WORDPRESS_DEBUG_DISPLAY=false

# Optional Plugin Tokens & Object Cache Pro
# (Can be set here or placed as files on host: secrets/wp_sb_code.txt, secrets/wp_rocket_cf_api_key.txt, secrets/wp_redis_token.txt)
# WP_SB_CODE=token
# WP_ROCKET_CF_API_KEY=cf_token
# WP_REDIS_TOKEN=redis_token
# WP_REDIS_DATABASE=0
# WP_REDIS_PREFIX=site1_ # Defaults automatically to ${SITE_USER}_
# WP_REDIS_DISABLED=false

# Administration & Update Performance (wp-performance.php mu-plugin)
# Flush FastCGI buffers early on update pages (default: true)
# WP_PERF_FASTCGI_FINISH=true
# Enforce IPv4 for external cURL calls in IPv4-only stack (default: true)
# WP_PERF_FORCE_IPV4=true

# Translation Updates Disabler (wp-translation-updates-disabler.php mu-plugin)
# Disable background/async translation auto-updates globally (default: false)
# WP_TRANSLATION_DISABLE_AUTO_UPDATES=false
# Comma-separated slugs to exclude from translation updates, or * for all
# WP_TRANSLATION_BLOCKED_SLUGS=plugin-slug,theme-slug

# Browser Telemetry Blocker (wp-telemetry-blocker.php mu-plugin)
# Comma-separated URL substrings/domains to intercept in browser (Fetch/XHR/Beacon) with a synthetic 200 OK {}
# WP_TELEMETRY_BLOCKED_URLS=telemetry.example.com,analytics.example.net/collect

# Post & Page Duplicator (wp-post-duplicator.php mu-plugin)
# Comma-separated post types to allow cloning (e.g., post,page,product,portfolio), or none to disable (default: post,page)
# WP_DUPLICATOR_POST_TYPES=post,page
# Target status for duplicated items: draft, pending, private, or publish (default: draft)
# WP_DUPLICATOR_STATUS=draft
# Preserve original post author when cloning instead of assigning current user (default: true)
# WP_DUPLICATOR_KEEP_AUTHOR=true
# Required base capability in addition to per-post edit_post permission: edit_posts, publish_posts, edit_others_posts, edit_pages, or manage_options (default: edit_posts)
# WP_DUPLICATOR_CAPABILITY=edit_posts

# Core Head, Header & Comment Cleanup (wp-core-cleanup.php mu-plugin)
# Comma-separated <head> tags to remove: generator,wlwmanifest,rsd,shortlink,rest_links,feeds,oembed,dns_prefetch, * for all, or none to disable
# WP_CLEANUP_HEAD_TAGS=generator,wlwmanifest,rsd,shortlink,rest_links,feeds,oembed,dns_prefetch
# Remove X-Powered-By HTTP response header (default: true)
# WP_CLEANUP_HIDE_POWERED_BY=true
# Disable internal self-pingbacks and remove X-Pingback HTTP header (default: true)
# WP_CLEANUP_DISABLE_SELF_PING=true
# Disable WordPress core Emoji detection scripts and styles (default: true)
# WP_CLEANUP_DISABLE_EMOJIS=true
# Comma-separated comment cleanups: url_field,make_clickable,reply_js,recent_styles, * for all, or none to disable (default: url_field,make_clickable,reply_js)
# WP_CLEANUP_COMMENTS=url_field,make_clickable,reply_js
# Disable Gutenberg global styles inline CSS and SVG duotone filters on frontend (default: false)
# WP_CLEANUP_DISABLE_GLOBAL_STYLES=false
# Remove jquery-migrate dependency from frontend jQuery bundle (default: false)
# WP_CLEANUP_DISABLE_JQUERY_MIGRATE=false
# Disable WordPress speculative loading rules output (default: false)
# WP_CLEANUP_DISABLE_SPECULATIVE_LOADING=false

# Slug & Filename Transliterator (wp-transliterator.php mu-plugin)
# Conversion table: universal (multi / all combined multilingual table), auto (detect from WordPress get_locale()), uk, ISO9, bel, bg_BG, mk_MK, sr_RS, kk, el, hy, ka_GE, or he_IL (default: universal)
# WP_TRANSLIT_TABLE=universal
# Transliterate newly saved post, page, and taxonomy term slugs (default: true)
# WP_TRANSLIT_SLUGS=true
# Transliterate newly uploaded media filenames, normalize macOS NFD characters, and strip European accents via remove_accents() (default: true)
# WP_TRANSLIT_FILENAMES=true
# Optional comma-separated character overrides applied on top of the selected table (e.g., ц:ts,Ц:TS)
# WP_TRANSLIT_OVERRIDES=

# YouTube Channel Statistics & oEmbed Tools (wp-youtube.php mu-plugin)
# Replace ?feature=oembed in YouTube iframe embeds with clean player parameters (default: true)
# WP_YOUTUBE_OEMBED_CLEANUP=true
# Rewrite youtube.com/embed/ to privacy-enhanced youtube-nocookie.com/embed/ (default: true)
# WP_YOUTUBE_NOCOOKIE=true
# Custom query string parameters appended to YouTube oEmbed iframe URLs
# WP_YOUTUBE_OEMBED_PARAMS=rel=0&playsinline=1&iv_load_policy=3
# Register [ytv], [yts], and [ytc] channel statistics shortcodes (default: false)
# WP_YOUTUBE_SHORTCODES=false
# Default YouTube Data API v3 key (prefer Docker secret wp_youtube_api_key.txt in production)
# WP_YOUTUBE_API_KEY=
# Default YouTube channel ID (prefer Docker secret wp_youtube_channel_id.txt in production)
# WP_YOUTUBE_CHANNEL_ID=

# Conditional Snippets, Preloads & Asset Control (wp-snippets.php mu-plugin)
# Rule syntax: target|modifier1|modifier2; target2|modifier1
# Audience modifiers: guest, auth, all, role:editor,author (WP_GTM_ID defaults to guest; others default to all)
# Device modifiers: desktop, mobile
# Location modifiers (prefix with ! to negate): front, home, page, page:10,20,contact, single, single:42, singular:product, archive, archive:product, category:1,news, tag:promo, tax:product_cat:12,shoes
# ACF field modifiers (prefix with ! to negate): acf:enable_math, acf:field_a,field_b
# Editor modifier (for fonts): editor (loads font preload/stylesheet in Elementor and Gutenberg editors)
# WP_GTM_ID=GTM-XXXXXXX
# WP_FONTS_PRELOAD=/wp-content/fonts/heading-bold.woff2|editor; /wp-content/fonts/body-regular.woff2|editor
# WP_FONTS_STYLES=/wp-content/fonts/custom-fonts.css|editor
# WP_PRELOAD_IMAGES=/wp-content/uploads/hero-desktop.webp|front|desktop; /wp-content/uploads/hero-mobile.webp|front|mobile
# WP_DEREGISTER_STYLES=wp-block-library,wp-block-library-theme,wc-block-style,global-styles|!single; plugin-modal-style|guest|front
# WP_DEREGISTER_SCRIPTS=comment-reply|!single
# WP_SNIPPETS_HEAD=
# WP_SNIPPETS_BODY=
# WP_SNIPPETS_FOOTER=modal-critical.css|guest|front; passive-events.js

