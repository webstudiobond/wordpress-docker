# Optional WordPress Application Overrides
# Copy to wordpress.env in your site directory (/home/${SITE_USER}/wordpress.env)
# Full documentation & configuration guide:
# https://github.com/webstudiobond/wordpress-docker/blob/main/README.md
# https://developer.wordpress.org/advanced-administration/wordpress/wp-config/
# IMPORTANT: Always enclose all environment variable values in single quotes ('...')
# to prevent shell expansions, quote collisions, and Docker Compose parsing errors.

# WORDPRESS_DISABLE_CRON=''

# WORDPRESS_POST_REVISIONS=''

# WORDPRESS_FS_CHMOD_DIR='0750'
# WORDPRESS_FS_CHMOD_FILE='0640'

# WORDPRESS_HOME=''
# WORDPRESS_SITEURL=''
# WORDPRESS_CLI_HOST=''

# Memory Limits (within container limit of 768M)
# WORDPRESS_MEMORY_LIMIT='256M'
# WORDPRESS_MAX_MEMORY_LIMIT='512M'

# Debugging
# WORDPRESS_DEBUG='false'
# WORDPRESS_DEBUG_LOG=''
# WORDPRESS_DEBUG_DISPLAY=''

# WP_REDIS_DISABLED='false'

# Platform MU-Plugins (comma-separated list of required slugs, or 'none' to disable all)
# Available slugs: acf-editor-control, admin-control, core-cleanup, notify, performance, post-duplicator, reading-time, snippets, telemetry-blocker, translation-updates-disabler, transliterator, youtube
# WP_ENABLED_MU_PLUGINS='notify'

# Administration & Update Performance (wp-performance.php)
# https://github.com/webstudiobond/wordpress-docker/blob/main/docs/mu-plugins/wp-performance.md
# WP_PERF_FASTCGI_FINISH='true'
# WP_PERF_FORCE_IPV4='true'

# Translation Updates Disabler (wp-translation-updates-disabler.php)
# https://github.com/webstudiobond/wordpress-docker/blob/main/docs/mu-plugins/wp-translation-updates-disabler.md
# WP_TRANSLATION_DISABLE_AUTO_UPDATES='false'
# WP_TRANSLATION_BLOCKED_SLUGS=''

# Browser Telemetry Blocker (wp-telemetry-blocker.php)
# https://github.com/webstudiobond/wordpress-docker/blob/main/docs/mu-plugins/wp-telemetry-blocker.md
# WP_TELEMETRY_BLOCKED_URLS=''

# Post & Page Duplicator (wp-post-duplicator.php)
# https://github.com/webstudiobond/wordpress-docker/blob/main/docs/mu-plugins/wp-post-duplicator.md
# WP_DUPLICATOR_POST_TYPES='post,page'
# WP_DUPLICATOR_STATUS='draft'
# WP_DUPLICATOR_KEEP_AUTHOR='true'
# WP_DUPLICATOR_CAPABILITY='edit_posts'

# Core Head, Header & Comment Cleanup (wp-core-cleanup.php)
# https://github.com/webstudiobond/wordpress-docker/blob/main/docs/mu-plugins/wp-core-cleanup.md
# WP_CLEANUP_HEAD_TAGS='generator,wlwmanifest,rsd,shortlink,rest_links,feeds,oembed,dns_prefetch'
# WP_CLEANUP_HIDE_POWERED_BY='true'
# WP_CLEANUP_DISABLE_SELF_PING='true'
# WP_CLEANUP_DISABLE_EMOJIS='true'
# WP_CLEANUP_COMMENTS='url_field,make_clickable,reply_js'
# WP_CLEANUP_DISABLE_GLOBAL_STYLES='false'
# WP_CLEANUP_DISABLE_JQUERY_MIGRATE='false'
# WP_CLEANUP_DISABLE_SPECULATIVE_LOADING='false'

# Slug & Filename Transliterator (wp-transliterator.php)
# https://github.com/webstudiobond/wordpress-docker/blob/main/docs/mu-plugins/wp-transliterator.md
# WP_TRANSLIT_TABLE='universal'
# WP_TRANSLIT_SLUGS='true'
# WP_TRANSLIT_FILENAMES='true'
# WP_TRANSLIT_OVERRIDES=''

# YouTube Channel Statistics & oEmbed Tools (wp-youtube.php)
# https://github.com/webstudiobond/wordpress-docker/blob/main/docs/mu-plugins/wp-youtube.md
# WP_YOUTUBE_OEMBED_CLEANUP='true'
# WP_YOUTUBE_NOCOOKIE='true'
# WP_YOUTUBE_OEMBED_PARAMS='rel=0&playsinline=1&iv_load_policy=3'
# WP_YOUTUBE_SHORTCODES='false'
# WP_YOUTUBE_API_KEY=''
# WP_YOUTUBE_CHANNEL_ID=''

# Conditional Snippets, Preloads & Asset Control (wp-snippets.php)
# https://github.com/webstudiobond/wordpress-docker/blob/main/docs/mu-plugins/wp-snippets.md
# WP_GTM_ID=''
# WP_FONTS_PRELOAD=''
# WP_FONTS_STYLES=''
# WP_PRELOAD_IMAGES=''
# WP_DEREGISTER_STYLES=''
# WP_DEREGISTER_SCRIPTS=''
# WP_SNIPPETS_HEAD=''
# WP_SNIPPETS_BODY=''
# WP_SNIPPETS_FOOTER=''

# Administrative Hardening & Dashboard Control (wp-admin-control.php)
# https://github.com/webstudiobond/wordpress-docker/blob/main/docs/mu-plugins/wp-admin-control.md
# WP_ADMIN_SIDEBAR_MENU_CONTROL=''
# WP_ADMIN_USER_ACTIONS_CONTROL=''
# WP_ADMIN_SIDEBAR_MENU_ORDER=''
# WP_ADMIN_SIDEBAR_MENU_SEPARATORS_AFTER=''

# WP_ADMIN_TOPBAR_MENU_REMOVE=''
# WP_ADMIN_TOPBAR_USER_PROFILE_REMOVE=''

# WP_ADMIN_TOPBAR_CUSTOM_MENU_1_ID=''
