<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/13.4/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         executionOrder="default"
         resolveDependencies="true"
         failOnRisky="true"
         failOnWarning="true">
    <testsuites>
        <testsuite name="WordPress Docker Test Suite">
            <directory>tests</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <file>mu-plugins/sbs-loader.php</file>
            <file>prepend/sbs-prepend.php</file>
            <directory>mu-plugins/sbs-platform</directory>
        </include>
    </source>
</phpunit>

